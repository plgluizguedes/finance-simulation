# Copie este arquivo para .env e preencha à mão. O .env nunca vai para o Git.
# Nenhuma chave tem valor padrão: se uma chave obrigatória faltar, o programa para com uma mensagem clara.

# brapi.dev (opcional). Sem token, só PETR4, VALE3, MGLU3 e ITUB4 respondem.
BRAPI_TOKEN=

# Reservado para a etapa futura do agente de IA (Gemini). Não é lido nesta etapa.
GEMINI_API_KEY=
